# Managed by Ansible (roles/wireguard, {{ wireguard_mode }} mode) - do not edit by hand
[Interface]
Address = {{ wireguard_address }}
PrivateKey = {{ wireguard_private_key }}
{% if wireguard_listen_port %}
ListenPort = {{ wireguard_listen_port }}
{% endif %}
{% if wireguard_mtu %}
MTU = {{ wireguard_mtu }}
{% endif %}
{% if wireguard_dns %}
DNS = {{ wireguard_dns }}
{% endif %}
{% for line in wireguard_postup %}
PostUp = {{ line }}
{% endfor %}
{% for line in wireguard_postdown %}
PostDown = {{ line }}
{% endfor %}
{% for peer in wireguard_resolved_peers | default([]) %}

[Peer]
# {{ peer.name | default(peer.host | default('peer')) }}
PublicKey = {{ peer.public_key }}
AllowedIPs = {{ ([peer.allowed_ips] if peer.allowed_ips is string else peer.allowed_ips) | join(', ') }}
{% if peer.endpoint is defined %}
Endpoint = {{ peer.endpoint }}
{% endif %}
{% set keepalive = peer.persistent_keepalive | default(wireguard_persistent_keepalive) %}
{% if keepalive %}
PersistentKeepalive = {{ keepalive }}
{% endif %}
{% endfor %}
